# ========================================
# ENVIRONMENT VARIABLES TEMPLATE
# ========================================
# Copy this file to create your environment configuration:
#   - For production: cp .env.example .env
#   - For local dev: cp .env.example .env.local
#
# Then fill in your actual values and remove the comments

# ========================================
# Supabase Configuration
# ========================================
# Production: https://your-project.supabase.co
# Local dev: http://127.0.0.1:54327
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key (only needed for Node.js scripts in /scripts directory)
# Use the **legacy JWT** service_role key from Supabase Dashboard → Settings → API
# (sb_secret_* keys may not work with supabase-js admin APIs; seed script falls back to admin login)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt

# ========================================
# App Configuration
# ========================================
VITE_APP_NAME=Sunday Properties
VITE_APP_VERSION=1.0.0
# Options: development | production
VITE_APP_ENV=development
VITE_ENVIRONMENT=development

# ========================================
# API Configuration
# ========================================
VITE_API_BASE_URL=https://api.sundayproperties.com
VITE_MAPS_API_KEY=your-google-maps-api-key
VITE_XAI_API_KEY=your-xai-api-key

# ========================================
# Payment Configuration
# ========================================
# Set to 'true' to simulate payments without Stripe
# Production: false (real payments)
# Local dev: true (test mode)
VITE_PAYMENT_TEST_MODE=true
VITE_STRIPE_PUBLIC_KEY=your-stripe-public-key
VITE_PAYPAL_CLIENT_ID=your-paypal-client-id

# ========================================
# Analytics
# ========================================
VITE_GOOGLE_ANALYTICS_ID=your-ga-id
VITE_MIXPANEL_TOKEN=your-mixpanel-token

# ========================================
# File Upload Configuration
# ========================================
# Max file size in bytes (default: 10MB)
VITE_MAX_FILE_SIZE=10485760
# Allowed MIME types (comma-separated)
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ========================================
# Collaborative Editing (Yjs WebSocket Server)
# ========================================
# Production: wss://your-yjs-server.com
# Local dev: ws://localhost:1234
# Run local server with: npm run yjs:server
VITE_YJS_WS_URL=ws://localhost:1234
# Set to 'false' to disable WebSocket connections
VITE_ENABLE_YJS_WEBSOCKET=true

# ========================================
# Supabase Realtime
# ========================================
# Set to 'false' to disable realtime connections (useful for debugging)
VITE_ENABLE_REALTIME=true

# ========================================
# Notion (docs sync — scripts/sync-docs-to-notion.mjs)
# ========================================
# Internal integration token: https://www.notion.so/my-integrations
# Share the "📚 Documentación" page (under Plataforma Sunday — Desarrollo) with the integration.
NOTION_TOKEN=your-notion-internal-integration-token
# Page ID of docs root (default: Sunday Properties teamspace docs mirror)
NOTION_DOCS_ROOT_PAGE_ID=386a689f002581b69441c5ce00d1b9ff

# ========================================
# Debug / Development Flags
# ========================================
# Show debug links in navigation (development only)
# Production: false
# Local dev: true
VITE_SHOW_DEBUG_LINKS=true
